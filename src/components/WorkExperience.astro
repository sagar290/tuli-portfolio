---
const projects = [
  {
    name: 'Alopoth',
    logo: '/logos/alopoth.png',
    website: 'http://alopoth.com/',
    demo: 'https://www.facebook.com/share/v/19boBYFiCj/',
  },
  {
    name: 'Deshistartup',
    logo: '/logos/deshistartup.png',
    website: 'https://deshistartup.com/',
    demo: 'https://www.facebook.com/share/v/1F2YSvBGur/',
  },
];

const roles = [
  {
    title: 'Recitation Teacher',
    organization: 'Department of Women and Child Affairs',
    period: 'Sep 2020 – Present',
    responsibilities: [
      'Served as a program volunteer, organizing cultural and educational competitions.',
      'Coordinated parent–teacher meetings and gatherings for guardians.',
    ],
  },
  {
    title: 'Cultural Editor — Youth Forum, Barishal District',
    organization: 'Voluntary Service Overseas',
    period: 'June 2023 – June 2024',
    responsibilities: [
      'Organized cultural programs, dramas, and talent shows for national and international observances.',
      'Engaged and recruited young volunteers in Barishal through creative and artistic activities.',
      'Created opportunities for local youth to showcase their creative skills and develop leadership.',
    ],
  },
  {
    title: 'Recitation Trainer',
    organization: 'Ideal Pre Cadet School, Barishal',
    period: 'Jan 2017 – Dec 2019',
    responsibilities: [
      'Trained students in pronunciation, voice projection, voice modulation, articulation, and stage presence.',
      'Developed lesson plans for recitation and public speaking over three years.',
      'Prepared students for national competitions and public performances, building confidence on stage.',
    ],
  },
];

const certificates = [
  {
    title: 'Recitation and Pronunciation',
    organization: 'Shilpakala Academy, Muladi, Barishal',
    year: '2013',
    duration: '3 days',
    logo: 'https://images.seeklogo.com/logo-png/61/1/bangladesh-shilpakala-academy-logo-png_seeklogo-611881.png',
    logoAlt: 'Bangladesh Shilpakala Academy logo',
    url: 'https://shilpakala.gov.bd/',
  },
  {
    title: 'Girl Guides Training — Guide Camping',
    organization: 'Bangladesh Girl Guides Association',
    year: '2017',
    duration: '3 days',
    logo: 'https://s3.eu-west-2.amazonaws.com/wagggs.prod/images/LOGO_-_BANGLADESH.max-300x150.jpg',
    logoAlt: 'Bangladesh Girl Guides Association emblem',
    url: 'https://girlguides.portal.gov.bd/',
  },
  {
    title: 'Day-long Training on Climate Change',
    organization: 'CFTM, ICCCAD, and BRAC',
    year: '2017',
    duration: '1 day',
    logo: 'https://iub.ac.bd/media-backend/media/icccad-df81f3a0-2b56-40fd-a41f-232ebdaef253.png',
    logoAlt: 'ICCCAD logo',
    url: 'https://icccad.net/',
  },
];
---

<section id="experience" aria-labelledby="experience-title" class="py-24 md:py-32 bg-cream scroll-mt-24">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-sm font-sans font-semibold tracking-widest uppercase text-charcoal/60 mb-4">Voice, Teaching & Culture</p>
      <h2 id="experience-title" class="text-4xl md:text-5xl lg:text-6xl font-serif text-charcoal mb-6 font-bold tracking-tight">Work Experience</h2>
      <p class="text-xl text-charcoal/70 font-sans max-w-2xl mx-auto font-light leading-relaxed">
        From voiceover collaborations to recitation training and cultural programs, helping stories and voices reach an audience.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {projects.map(project => (
        <article class="bg-white rounded-3xl border border-gold/20 p-8 md:p-10">
          <img
            src={project.logo}
            alt={`${project.name} logo`}
            width="80"
            height="80"
            loading="lazy"
            decoding="async"
            class="w-20 h-20 object-contain rounded-xl mb-6"
          />
          <p class="text-sm font-sans tracking-widest uppercase text-charcoal/60 mb-4">Voiceover</p>
          <h3 class="text-3xl md:text-4xl font-serif font-semibold text-charcoal mb-8">{project.name}</h3>
          <div class="flex flex-wrap items-center gap-6 font-sans">
            <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${project.name} demo on Facebook (opens in a new tab)`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-charcoal text-cream font-medium hover:bg-gold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-charcoal">
              <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              Watch Demo
            </a>
            <a href={project.website} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} website (opens in a new tab)`} class="text-charcoal underline underline-offset-4 hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-charcoal">
              Visit Website <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="mt-5 text-sm font-sans text-charcoal/60">Demo opens on Facebook.</p>
        </article>
      ))}
    </div>
    <div class="max-w-5xl mx-auto mt-16 md:mt-20">
      <h3 class="text-2xl md:text-3xl font-serif font-semibold text-charcoal mb-10">Teaching & Cultural Experience</h3>
      <div class="border-l border-gold/30 ml-2 space-y-12">
        {roles.map(role => (
          <article class="relative pl-6 md:pl-10">
            <span aria-hidden="true" class="absolute -left-1.5 top-2 h-3 w-3 rounded-full bg-gold"></span>
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 md:gap-8 mb-4">
              <div class="min-w-0">
                <h4 class="text-xl md:text-2xl font-serif font-semibold text-charcoal leading-snug">{role.title}</h4>
                <p class="mt-2 text-base font-sans font-medium text-charcoal/80">{role.organization}</p>
              </div>
              <p class="shrink-0 text-sm font-sans text-charcoal/60 md:pt-1">{role.period}</p>
            </div>
            <ul class="list-disc pl-5 space-y-2 text-base font-sans text-charcoal/70 leading-relaxed marker:text-gold">
              {role.responsibilities.map(responsibility => <li>{responsibility}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
    <div class="max-w-5xl mx-auto mt-20 md:mt-24">
      <div class="text-center mb-10 md:mb-12">
        <p class="text-xs md:text-sm font-sans font-semibold tracking-[0.18em] uppercase text-charcoal/60 mb-3">Professional Development</p>
        <h3 class="text-3xl md:text-4xl font-serif font-semibold text-charcoal">Training & Certificates</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {certificates.map(certificate => (
          <article class="min-w-0 border border-gold/50 bg-cream/60 p-2 last:md:col-span-2 last:md:mx-auto last:md:w-[calc(50%-0.75rem)]">
            <div class="flex min-h-64 h-full flex-col items-center border border-gold/25 bg-white px-6 py-7 md:px-8 text-center">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-gold/40 bg-cream/50 p-2">
                <img src={certificate.logo} alt={certificate.logoAlt} loading="lazy" decoding="async" class="max-h-8 max-w-8 object-contain" />
              </div>
              <p class="mt-4 text-[0.65rem] font-sans font-semibold tracking-[0.22em] uppercase text-charcoal/55">Certificate of Training</p>
              <h4 class="mt-3 text-xl md:text-2xl font-serif font-semibold leading-snug text-charcoal">{certificate.title}</h4>
              <div class="my-4 h-px w-14 bg-gold/50" aria-hidden="true"></div>
              <p class="text-sm md:text-base font-sans leading-relaxed text-charcoal/70">{certificate.organization}</p>
              <p class="mt-3 text-sm font-sans font-medium text-charcoal/60">{certificate.year}<span aria-hidden="true"> · </span>{certificate.duration}</p>
              <a href={certificate.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${certificate.organization} website (opens in a new tab)`} class="mt-auto pt-5 text-xs font-sans text-charcoal/65 underline underline-offset-4 hover:text-gold transition-colors">
                Issuing organization <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
